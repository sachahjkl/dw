package web

import (
	"fmt"
	"strings"

	"github.com/sachahjkl/dw/internal/cockpit"
)

templ page(view pageView) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>DevWorkflow</title>
			<link rel="stylesheet" href={ assetURL("app.css") }/>
			<script type="module" src={ assetURL("app.js") }></script>
			<script type="module" src={ assetURL("datastar.js") }></script>
		</head>
		<body data-action-response-timeout={ fmt.Sprint(view.ActionResponseTimeoutMilliseconds) } data-signals="{activeTab:sessionStorage.getItem('dw.activeTab')||'overview'}" data-init="@get('/events')">
			<a class="skip-link" href="#main">Skip to content</a>
			@appHeader(view.ActiveActionCount)
			<main id="main">
				@navigation()
				@liveSections(view)
			</main>
			<footer>Datastar v1.0.2 · <a href="/assets/datastar-LICENSE.md">MIT license</a></footer>
		</body>
	</html>
}

templ appHeader(activeActions int) {
	<header id="app-header" class="app-header">
		<h1>DevWorkflow</h1>
		@actionsShortcut(activeActions)
	</header>
}

templ actionsShortcut(activeActions int) {
	<button id="tab-actions" type="button" aria-controls="actions" aria-pressed="false" class="actions-link" data-tab="actions" data-class:active="$activeTab === 'actions'" data-attr:aria-pressed="$activeTab === 'actions' ? 'true' : 'false'" data-on:click="$activeTab = 'actions'; sessionStorage.setItem('dw.activeTab','actions')">
		<span>Actions</span>
		<span class="count-badge" aria-label={ fmt.Sprintf("%d active actions", activeActions) }>{ fmt.Sprint(activeActions) }</span>
	</button>
}

templ navigation() {
	<nav class="navbar" aria-label="Main views" role="tablist" aria-orientation="horizontal">
		<div class="nav-tabs">
			<button id="tab-overview" type="button" role="tab" aria-controls="overview" aria-selected="true" tabindex="0" class="nav-tab" data-tab="overview" data-class:active="$activeTab === 'overview'" data-attr:aria-selected="$activeTab === 'overview' ? 'true' : 'false'" data-attr:tabindex="$activeTab === 'overview' ? '0' : '-1'" data-on:click="$activeTab = 'overview'; sessionStorage.setItem('dw.activeTab','overview')">Overview</button>
			<button id="tab-work" type="button" role="tab" aria-controls="work" aria-selected="false" tabindex="-1" class="nav-tab" data-tab="work" data-class:active="$activeTab === 'work'" data-attr:aria-selected="$activeTab === 'work' ? 'true' : 'false'" data-attr:tabindex="$activeTab === 'work' ? '0' : '-1'" data-on:click="$activeTab = 'work'; sessionStorage.setItem('dw.activeTab','work')">Work</button>
			<button id="tab-workspaces" type="button" role="tab" aria-controls="workspaces" aria-selected="false" tabindex="-1" class="nav-tab" data-tab="workspaces" data-class:active="$activeTab === 'workspaces'" data-attr:aria-selected="$activeTab === 'workspaces' ? 'true' : 'false'" data-attr:tabindex="$activeTab === 'workspaces' ? '0' : '-1'" data-on:click="$activeTab = 'workspaces'; sessionStorage.setItem('dw.activeTab','workspaces')">Workspaces</button>
			<button id="tab-pull-requests" type="button" role="tab" aria-controls="pull-requests" aria-selected="false" tabindex="-1" class="nav-tab" data-tab="pull-requests" data-class:active="$activeTab === 'pull-requests'" data-attr:aria-selected="$activeTab === 'pull-requests' ? 'true' : 'false'" data-attr:tabindex="$activeTab === 'pull-requests' ? '0' : '-1'" data-on:click="$activeTab = 'pull-requests'; sessionStorage.setItem('dw.activeTab','pull-requests')">Pull requests</button>
			<button id="tab-data" type="button" role="tab" aria-controls="data" aria-selected="false" tabindex="-1" class="nav-tab" data-tab="data" data-class:active="$activeTab === 'data'" data-attr:aria-selected="$activeTab === 'data' ? 'true' : 'false'" data-attr:tabindex="$activeTab === 'data' ? '0' : '-1'" data-on:click="$activeTab = 'data'; sessionStorage.setItem('dw.activeTab','data')">Data</button>
			<button id="tab-settings" type="button" role="tab" aria-controls="settings" aria-selected="false" tabindex="-1" class="nav-tab" data-tab="settings" data-class:active="$activeTab === 'settings'" data-attr:aria-selected="$activeTab === 'settings' ? 'true' : 'false'" data-attr:tabindex="$activeTab === 'settings' ? '0' : '-1'" data-on:click="$activeTab = 'settings'; sessionStorage.setItem('dw.activeTab','settings')">Settings</button>
		</div>
	</nav>
}

templ liveSections(view pageView) {
	<div id="live-sections">
		@notifications(view.Toasts)
		@resourceSections(view)
		@executionsSection(view.Executions, view.ActiveActionCount)
		@resultDialogs(view.Executions)
	</div>
}

templ resourceSections(view pageView) {
	<div id="resource-sections">
		<div id="semantic-operations" hidden>@operationControls(view.CSRF, view.Snapshot.Operations)</div>
		if view.Error != "" {
			<p class="error page-error" role="alert"><strong>Refresh failed</strong><span>{ view.Error }</span></p>
		}
		@dashboardSection(view)
		@workSection(view)
		@workspacesSection(view)
		@pullRequestsSection(view)
		@dataSection(view)
		@settingsSection(view)
	</div>
}

templ notifications(toasts []toastView) {
	<aside id="action-notifications" class="toast-stack" aria-label="Notifications" aria-live="assertive">
		if len(toasts) != 0 {
			for _, toast := range toasts {
				<button type="button" class="toast" data-expires-at={ fmt.Sprint(toast.ExpiresAt) } data-tab={ toast.Target } data-on:click={ "$activeTab = '" + toast.Target + "'; sessionStorage.setItem('dw.activeTab','" + toast.Target + "')" }>
					<strong>{ toast.Title }</strong>
					<span>{ toast.Detail }</span>
					<small>Open</small>
				</button>
			}
		}
	</aside>
}

templ dashboardSection(view pageView) {
	<section id="overview" class="tab-panel active" role="tabpanel" aria-labelledby="tab-overview" tabindex="0" data-class:active="$activeTab === 'overview'">
		<header class="panel-heading">
			<div><p class="eyebrow">At a glance</p><h2>Overview</h2></div>
			<p>Active work, blockers, outcomes, and available next operations.</p>
		</header>
		<dl class="metrics">
			<div><dt>Projects</dt><dd>{ fmt.Sprint(view.Snapshot.ProjectCount) }</dd></div>
			<div><dt>Repositories</dt><dd>{ fmt.Sprint(view.Snapshot.RepositoryCount) }</dd></div>
			<div><dt>Workspaces</dt><dd>{ fmt.Sprint(len(view.Snapshot.Workspaces)) }</dd></div>
			<div><dt>Active actions</dt><dd>{ fmt.Sprint(view.ActiveActionCount) }</dd></div>
			<div><dt>Doctor</dt><dd>{ fmt.Sprint(view.Snapshot.DoctorOK) }</dd></div>
		</dl>
		if view.Snapshot.NeedsInit && view.Snapshot.InitOperation != nil {
			<article class="guided-error">
				<strong>Initialization required</strong>
				<p>Initialize this root before you start work.</p>
				@operationControls(view.CSRF, []cockpit.Operation{*view.Snapshot.InitOperation})
			</article>
		}
		<div class="settings-grid overview-workflow">
			<article class="settings-card">
				<h3>Active work</h3>
				if items := activeExecutions(view.Executions); len(items) != 0 {
					<ul>
						for _, item := range items {
							<li><button type="button" class="text-action" data-tab="actions" data-on:click="$activeTab = 'actions'; sessionStorage.setItem('dw.activeTab','actions')">{ item.Title } · { item.StatusLabel }</button></li>
						}
					</ul>
				} else {
					<p class="empty">No active operations.</p>
				}
			</article>
			<article class="settings-card">
				<h3>Blockers</h3>
				if items := pageBlockers(view); len(items) != 0 {
					<ul>
						for _, item := range items {
							<li><strong>{ item.Title }</strong><br/><span>{ item.Detail }</span></li>
						}
					</ul>
				} else {
					<p class="empty">No blockers detected.</p>
				}
			</article>
			<article class="settings-card">
				<h3>Recent outcomes</h3>
				if items := recentOutcomes(view.Executions); len(items) != 0 {
					<ul>
						for _, item := range items {
							<li><button type="button" class="text-action" data-tab="actions" data-on:click="$activeTab = 'actions'; sessionStorage.setItem('dw.activeTab','actions')">{ item.Title } · { item.StatusLabel }</button></li>
						}
					</ul>
				} else {
					<p class="empty">No completed operations.</p>
				}
			</article>
		</div>
		<div class="project-list overview-grid">
			for _, item := range view.Snapshot.Cockpit {
				<article class="project-card">
					<header><div><p class="eyebrow">{ humanLabel(item.Section) }</p><h3>{ item.Title }</h3></div><span class={ "status " + string(item.Severity) }>{ item.Status }</span></header>
					if item.Subtitle != "" {
						<p>{ item.Subtitle }</p>
					}
					if current := executionForResource(view.Executions, item.Ref); current != nil {
						<p class="action-summary"><strong>{ current.Title }</strong> · { current.StatusLabel }</p>
					}
					@operationControls(view.CSRF, []cockpit.Operation{item.Primary})
				</article>
			}
		</div>
	</section>
}

templ workSection(view pageView) {
	<section id="work" class="tab-panel" role="tabpanel" aria-labelledby="tab-work" tabindex="0" data-class:active="$activeTab === 'work'">
		<header class="panel-heading">
			<div><p class="eyebrow">Assigned items</p><h2>Work</h2></div>
			<p>Work grouped by configured project.</p>
		</header>
		if len(view.Work) == 0 {
			<p class="empty-state">No work items are available.</p>
		}
		<div class="project-list">
			for _, project := range view.Work {
				<article class="project-card">
					<header>
						<div><p class="eyebrow">Project</p><h3>{ project.Label }</h3></div>
						<span class="provider-badge">{ providerLabel(project.Provider) }</span>
					</header>
					if current := executionForResource(view.Executions, project.Ref); current != nil {
						<p class="action-summary">{ current.Title } · { current.StatusLabel }</p>
					}
					@operationControls(view.CSRF, project.Operations)
					if project.Error != "" {
						if recovery := workRecovery(project); recovery != nil {
							<div class="guided-error" role="alert">
								<strong>{ recovery.Title }</strong>
								<p>{ recovery.Detail }</p>
								<details>
									<summary>Technical details</summary>
									<code>{ project.Error }</code>
								</details>
							</div>
						} else {
							<div class="error" role="alert"><strong>Work items unavailable</strong><p>{ project.Error }</p></div>
						}
					}
					if len(project.Items) == 0 && project.Error == "" {
						<p class="empty">No assigned work items.</p>
					}
					if len(project.Items) != 0 {
						<ul class="item-list">
							for _, item := range project.Items {
								<li class="resource-card">
									<div>
										if item.URL != "" {
											<a href={ templ.SafeURL(item.URL) } target="_blank" rel="noopener noreferrer"><strong>{ item.Title }</strong></a>
										} else {
											<strong>{ item.Title }</strong>
										}
										<span><code>{ item.ID }</code> · { item.State }</span>
									</div>
									if current := executionForResource(view.Executions, item.Ref); current != nil {
										<p class="action-summary">{ current.Title } · { current.StatusLabel }</p>
									}
									@operationControls(view.CSRF, item.Operations)
								</li>
							}
						</ul>
					}
				</article>
			}
		</div>
	</section>
}

templ workspacesSection(view pageView) {
	<section id="workspaces" class="tab-panel" role="tabpanel" aria-labelledby="tab-workspaces" tabindex="0" data-class:active="$activeTab === 'workspaces'">
		<header class="panel-heading">
			<div><p class="eyebrow">Local tasks</p><h2>Workspaces</h2></div>
			<p>Branches and work items in active local workspaces.</p>
		</header>
		if len(view.Snapshot.Workspaces) == 0 {
			<p class="empty-state">No workspaces.</p>
		}
		if len(view.Snapshot.Workspaces) != 0 {
			<div class="project-list">
				for _, workspace := range view.Snapshot.Workspaces {
					<article class="project-card">
						<header>
							<div>
								<p class="eyebrow">
									{ workspace.Project } / { workspace.Kind }
									if workspace.WorkspaceID != "" {
										<span> / { workspace.WorkspaceID }</span>
									}
								</p>
								if workspace.Title != "" {
									<h3>{ workspace.Title }</h3>
								} else {
									<h3>{ workspace.Slug }</h3>
								}
							</div>
							<code>{ workspace.Branch }</code>
						</header>
						<p><code>{ workspace.Path }</code></p>
						<p>{ strings.Join(workspace.WorkItems, ", ") }</p>
						if current := executionForResource(view.Executions, workspace.Ref); current != nil {
							<p class="action-summary">{ current.Title } · { current.StatusLabel }</p>
						}
						@operationControls(view.CSRF, workspace.Operations)
					</article>
				}
			</div>
		}
	</section>
}

templ pullRequestsSection(view pageView) {
	<section id="pull-requests" class="tab-panel" role="tabpanel" aria-labelledby="tab-pull-requests" tabindex="0" data-class:active="$activeTab === 'pull-requests'">
		<header class="panel-heading">
			<div><p class="eyebrow">Reviews</p><h2>Pull requests</h2></div>
			<p>Open pull requests across configured projects.</p>
		</header>
		if len(view.PullRequests) == 0 {
			<p class="empty-state">No pull requests.</p>
		}
		if len(view.PullRequests) != 0 {
			<div class="project-list">
				for _, item := range view.PullRequests {
					<article class="project-card">
						<header>
							<div><p class="eyebrow">{ item.Project } · { item.Repository }</p><h3>
								if item.URL != "" {
									<a href={ templ.SafeURL(item.URL) } target="_blank" rel="noopener noreferrer">{ item.Title }</a>
								} else {
									{ item.Title }
								}
							</h3></div>
							if item.Draft {
								<span class="provider-badge">Draft</span>
							}
						</header>
						<p><code>{ item.Branch }</code> → <code>{ item.TargetBranch }</code></p>
						if current := executionForResource(view.Executions, item.Ref); current != nil {
							<p class="action-summary">{ current.Title } · { current.StatusLabel }</p>
						}
						@operationControls(view.CSRF, item.Operations)
					</article>
				}
			</div>
		}
	</section>
}

templ dataSection(view pageView) {
	<section id="data" class="tab-panel" role="tabpanel" aria-labelledby="tab-data" tabindex="0" data-class:active="$activeTab === 'data'">
		<header class="panel-heading">
			<div><p class="eyebrow">Connections</p><h2>Data</h2></div>
			<p>Configured data sources and their providers.</p>
		</header>
		if len(view.Snapshot.DataSources) == 0 {
			<p class="empty-state">No data sources.</p>
		}
		if len(view.Snapshot.DataSources) != 0 {
			<ul class="resource-list">
				for _, source := range view.Snapshot.DataSources {
					<li class="resource-card">
						<div><strong>{ source.Key }</strong><span>{ source.Project }</span></div>
						<span class="provider-badge">{ providerLabel(source.Provider) }</span>
						if current := executionForResource(view.Executions, source.Ref); current != nil {
							<p class="action-summary">{ current.Title } · { current.StatusLabel }</p>
						}
						@operationControls(view.CSRF, source.Operations)
					</li>
				}
			</ul>
		}
	</section>
}

templ settingsSection(view pageView) {
	<section id="settings" class="tab-panel" role="tabpanel" aria-labelledby="tab-settings" tabindex="0" data-class:active="$activeTab === 'settings'">
		<header class="panel-heading">
			<div><p class="eyebrow">Environment</p><h2>Settings</h2></div>
			<p>Providers and effective configuration.</p>
		</header>
		<div class="settings-grid">
			<article class="settings-card">
				<h3>Providers</h3>
				<div class="columns">
					<div><h4>Work</h4><ul>
						for _, provider := range view.Snapshot.WorkProviders {
							<li>{ providerLabel(provider) }</li>
						}
					</ul></div>
					<div><h4>Data</h4><ul>
						for _, provider := range view.Snapshot.DataProviders {
							<li>{ providerLabel(provider) }</li>
						}
					</ul></div>
				</div>
			</article>
			<article class="settings-card">
				<h3>Configuration</h3>
				<dl>
					<div><dt>Root</dt><dd><code>{ view.Snapshot.Root }</code></dd></div>
					<div><dt>Default agent</dt><dd>{ providerLabel(view.Snapshot.DefaultAgent) }</dd></div>
					<div><dt>Color mode</dt><dd>{ providerLabel(view.Snapshot.ColorMode) }</dd></div>
					<div><dt>States</dt><dd>{ strings.Join(view.Snapshot.States, ", ") }</dd></div>
					<div><dt>Secrets</dt><dd>{ fmt.Sprint(len(view.Snapshot.SecretKeys)) } configured</dd></div>
				</dl>
			</article>
		</div>
	</section>
}

templ operationControls(csrf string, operations []cockpit.Operation) {
	if items := operationViews(csrf, operations); len(items) != 0 {
		<div class="operation-list">
			for _, operation := range items {
				<form class={ "operation operation-" + string(operation.Risk) } data-operation-key={ operation.Key } data-operation-subject={ operation.SubjectKey } data-operation-relation={ string(operation.Relation) } data-on:submit={ operation.Submit }>
					if operation.Description != "" {
						<p>{ operation.Description }</p>
					}
					if len(operation.Inputs) != 0 {
						<div class="form-grid">
							for _, input := range operation.Inputs {
								<div class="field">
									<label for={ input.ID }>{ input.Label }</label>
									if input.Kind == cockpit.InputSelect {
										<select id={ input.ID } data-bind={ input.Signal } required?={ input.Required }>
											<option value="">No selection</option>
											for _, option := range input.Options {
												<option value={ option.Value }>{ option.Label }</option>
											}
										</select>
									}
									if input.Kind == cockpit.InputBoolean {
										<label class="toggle" for={ input.ID }><input id={ input.ID } type="checkbox" data-bind={ input.Signal }/><span>Enabled</span></label>
									}
									if input.Kind == cockpit.InputText {
										<input id={ input.ID } type="text" data-bind={ input.Signal } required?={ input.Required }/>
									}
								</div>
							}
						</div>
					}
					<button type="submit" class="operation-button" data-operation-label={ operation.Label } data-operation-disabled={ fmt.Sprint(operation.Disabled) } disabled?={ operation.Disabled }><span class="operation-spinner" aria-hidden="true"></span><span class="operation-button-text">{ operation.Label }</span></button>
					if operation.DisabledReason != "" {
						<small>{ operation.DisabledReason }</small>
					}
				</form>
			}
		</div>
	}
}

templ executionsSection(executions []executionView, activeCount int) {
	<section id="actions" class="tab-panel" role="tabpanel" aria-labelledby="tab-actions" tabindex="0" data-class:active="$activeTab === 'actions'">
		<header class="panel-heading">
			<div><p class="eyebrow">Queue and history</p><h2>Actions</h2></div>
			<p>{ fmt.Sprintf("%d active · %d recent", activeCount, len(executions)) }</p>
		</header>
		if len(executions) == 0 {
			<p class="empty-state">No actions have run yet.</p>
		}
		<div class="action-list">
			for _, item := range executions {
				<article class="execution" data-execution-id={ item.ID } data-status={ string(item.Status) } data-status-label={ item.StatusLabel } data-progress={ item.Summary } data-interaction-label={ interactionLabel(item) } data-relation={ item.Relation } data-operation-key={ item.OperationKey } data-operation-subject={ item.SubjectKey }>
					<header>
						<div><p class="eyebrow">Action</p><h3>{ item.Title }</h3></div>
						<strong class={ "status " + string(item.Status) }>{ item.StatusLabel }</strong>
					</header>
					if item.Summary != "" {
						<p class="action-summary">{ item.Summary }</p>
					}
					<p class="action-meta">Created <time datetime={ item.CreatedAt } data-text={ fmt.Sprintf("globalThis.dwDateTimeFormatter.format(new Date(%q))", item.CreatedAt) }>{ item.CreatedAt }</time></p>
					if item.Failure != "" {
						<p class="error" role="alert">{ item.Failure }</p>
					}
					if item.Status.Final() {
						<button type="button" class="view-result" data-on:click={ fmt.Sprintf("globalThis.dwOpenActionDialog('result',%q)", item.ID) }>View result</button>
					}
					if item.Prompt != nil || item.Active && authenticationInteraction(item.Events) != nil {
						<button type="button" class="view-input" data-on:click={ fmt.Sprintf("globalThis.dwOpenActionDialog('interaction',%q)", item.ID) }>Provide input</button>
					}
					<div class="action-controls">
						if item.Active {
							<button type="button" data-on:click={ item.Cancel } aria-label={ "Cancel " + item.Title }>Cancel action</button>
						}
					</div>
					if len(item.Events) != 0 {
						<details class="activity">
							<summary>Activity</summary>
							<ol class="timeline">
								for _, event := range item.Events {
									<li><div><strong>{ event.KindLabel }</strong><time datetime={ event.At } data-text={ fmt.Sprintf("globalThis.dwTimeFormatter.format(new Date(%q))", event.At) }>{ event.At }</time></div><p>{ event.Message }</p></li>
								}
							</ol>
						</details>
					}
					<details class="technical-details">
						<summary>Technical details</summary>
						<dl><div><dt>Execution</dt><dd><code>{ item.ID }</code></dd></div><div><dt>Attempt</dt><dd><code>{ item.AttemptID }</code></dd></div></dl>
					</details>
				</article>
			}
		</div>
	</section>
}

templ resultDialogs(executions []executionView) {
	<div id="action-results">
		for _, item := range executions {
			if item.Prompt != nil || item.Active && authenticationInteraction(item.Events) != nil {
				@interactionDialog(item)
			} else if item.Status.Final() {
				@resultDialog(item)
			}
		}
	</div>
}

templ interactionDialog(item executionView) {
	<dialog id={ "interaction-" + item.ID } class="action-dialog interaction-dialog" data-execution-id={ item.ID } data-operation-key={ item.OperationKey } data-dialog-token={ interactionToken(item) } aria-labelledby={ "interaction-title-" + item.ID }>
		<form method="dialog" class="dialog-close"><button type="submit" aria-label="Close input">Close</button></form>
		<header>
			<p class="eyebrow">Action paused</p>
			<h2 id={ "interaction-title-" + item.ID }>{ item.Title }</h2>
		</header>
		if item.Prompt != nil {
			@promptForm(item.ID, *item.Prompt)
		}
		if event := authenticationInteraction(item.Events); event != nil {
			@authenticationPanel(*event)
		}
	</dialog>
}

templ authenticationPanel(event eventView) {
	if event.AuthorizationURL != "" {
			<div class="auth-panel" role="status">
				<p class="auth-kicker">Sign-in required</p>
				<h4>Continue with Microsoft</h4>
				<p>Complete sign-in in a secure Microsoft tab. This action updates after the callback.</p>
				<a class="auth-action" href={ templ.SafeURL(event.AuthorizationURL) } target="_blank" rel="noopener noreferrer">Continue with Microsoft</a>
				if event.CallbackURI != "" {
					<small>Callback listener: <code>{ event.CallbackURI }</code></small>
				}
			</div>
	}
	if event.VerificationURI != "" {
			<div class="auth-panel" role="status">
				<p class="auth-kicker">Sign-in required</p>
				<h4>Continue with Microsoft</h4>
				<p>Open Microsoft sign-in, then enter this device code.</p>
				<code class="device-code">{ event.UserCode }</code>
				<a class="auth-action" href={ templ.SafeURL(event.VerificationURI) } target="_blank" rel="noopener noreferrer">Open Microsoft sign-in</a>
			</div>
	}
}

templ resultDialog(item executionView) {
	<dialog id={ "result-" + item.ID } class="action-dialog result-dialog" data-execution-id={ item.ID } data-operation-key={ item.OperationKey } aria-labelledby={ "result-title-" + item.ID }>
		<form method="dialog" class="dialog-close"><button type="submit" aria-label="Close result">Close</button></form>
		<header>
			<p class="eyebrow">Action result</p>
			<h2 id={ "result-title-" + item.ID }>{ item.Title }</h2>
		</header>
		if item.Failure != "" {
			<p class="error result-error" role="alert">{ item.Failure }</p>
		}
		if item.ResultPage == nil && len(item.Result) == 0 && item.Failure == "" {
			<p class="result-summary">{ item.StatusLabel }</p>
		}
		if item.ResultPage != nil {
			@structuredResult(*item.ResultPage, item.SubjectKey)
		} else if len(item.Result) != 0 {
			<div class="terminal-result" role="region" aria-label="Terminal output" tabindex="0"><pre>
				for _, span := range item.Result {
					if span.Class != "" {
						<span class={ span.Class }>{ span.Text }</span>
					} else {
						{ span.Text }
					}
				}
			</pre></div>
		}
	</dialog>
}

templ structuredResult(result resultPageView, subjectKey string) {
	<div class="structured-result">
		<header class="result-heading">
			<h3>{ result.Title }</h3>
			if result.Badge != "" {
				<strong class={ "result-badge " + result.Status }>{ result.Badge }</strong>
			}
		</header>
		if len(result.Summary) != 0 {
			@resultFields(result.Summary)
		}
		for _, section := range result.Sections {
			<section class="result-section">
				if section.Title != "" {
					<h4>{ section.Title }</h4>
				}
				if len(section.Fields) != 0 {
					@resultFields(section.Fields)
				}
				if section.Table != nil {
					@resultTable(*section.Table)
				}
				for _, panel := range section.Panels {
					<article class="result-panel">
						if panel.Title != "" {
							<h5>{ panel.Title }</h5>
						}
						<p>{ panel.Body }</p>
					</article>
				}
				if len(section.Items) != 0 {
					<ul>
						for _, value := range section.Items {
							<li>{ value }</li>
						}
					</ul>
				}
			</section>
		}
		if result.Hint != nil {
			<aside class="result-hint">@resultFields([]resultFieldView{*result.Hint})</aside>
		}
		if len(result.Actions) != 0 {
			<nav class="result-actions" aria-label="Next actions">
				<span>Next</span>
				for _, action := range result.Actions {
					<button type="button" data-next-operation={ action.Relation } data-operation-subject={ subjectKey }>{ action.Label }</button>
				}
			</nav>
		}
	</div>
}

templ resultFields(fields []resultFieldView) {
	<dl class="result-fields">
		for _, field := range fields {
			<div><dt>{ field.Label }</dt><dd class={ field.Style }>{ field.Value }</dd></div>
		}
	</dl>
}

templ resultTable(table resultTableView) {
	<div class="result-table-wrap" role="region" tabindex="0">
		<table class="result-table">
			<thead><tr>
				for _, column := range table.Columns {
					<th scope="col">{ column }</th>
				}
			</tr></thead>
			<tbody>
				for _, row := range table.Rows {
					<tr>
						for _, value := range row {
							<td>{ value }</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ promptForm(executionID string, prompt promptView) {
	<form class="prompt" data-on:submit={ prompt.Submit } aria-label={ "Input for " + executionID }>
		<div><p class="eyebrow">Input required</p><h4>{ prompt.Label }</h4></div>
		if prompt.Help != "" {
			<p>{ prompt.Help }</p>
		}
		if prompt.Kind == "secret" {
			<input type="hidden" name="schema" value="1"/>
			<label>Secret <input type="password" name="value" required?={ prompt.Required } autocomplete="off" aria-label="Secret response"/></label>
		}
		if prompt.Kind == "confirm" {
			<label class="toggle"><input type="checkbox" data-bind={ prompt.Signal }/><span>Confirm</span></label>
		}
		if prompt.Kind == "select-one" {
			<label>Response <select data-bind={ prompt.Signal } required?={ prompt.Required }>
				for _, choice := range prompt.Choices {
					<option value={ choice.Value }>{ choice.Label }</option>
				}
			</select></label>
		}
		if prompt.Kind == "select-many" {
			<fieldset><legend>Responses</legend>
				for _, choice := range prompt.Choices {
					<label class="toggle"><input type="checkbox" data-bind={ choice.Signal }/><span>{ choice.Label }</span></label>
				}
			</fieldset>
		}
		if prompt.Kind == "text" {
			<label>Response <input type="text" data-bind={ prompt.Signal } required?={ prompt.Required }/></label>
		}
		<p class="prompt-feedback" role="status" aria-live="polite"></p>
		<button type="submit">Submit response</button>
	</form>
}
